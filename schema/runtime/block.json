{
  "name": "block",
  "label": "Block",
  "nestable": true,
  "controls": {
    "tag": {
      "label": "HTML tag",
      "type": "select",
      "options": {
        "div": "div",
        "section": "section",
        "a": "a [Link]",
        "article": "article",
        "nav": "nav",
        "ol": "ol",
        "ul": "ul",
        "li": "li",
        "aside": "aside",
        "address": "address",
        "figure": "figure",
        "custom": "Custom"
      },
      "lowercase": true,
      "inline": true,
      "placeholder": "div",
      "fullAccess": true,
      "tab": "content"
    },
    "_hidden": {
      "tab": "style",
      "type": "object",
      "virtual": true,
      "internal": true,
      "properties": {
        "_cssClasses": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "_alignItems": {
      "label": "Align cross axis",
      "type": "align-items",
      "css": [
        {
          "property": "align-items"
        }
      ],
      "required": [
        "_display",
        "=",
        [
          "flex",
          "inline-flex"
        ]
      ],
      "tab": "content"
    },
    "_direction": {
      "label": "Direction",
      "type": "direction",
      "css": [
        {
          "property": "flex-direction"
        }
      ],
      "inline": true,
      "rerender": true,
      "required": [
        "_display",
        "=",
        [
          "flex",
          "inline-flex"
        ]
      ],
      "tab": "content"
    },
    "_justifyContent": {
      "label": "Align main axis",
      "type": "justify-content",
      "css": [
        {
          "property": "justify-content"
        }
      ],
      "required": [
        "_display",
        "=",
