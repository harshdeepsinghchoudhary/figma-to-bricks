{
  "name": "bricks/list-element-types",
  "label": "Bricks element catalog",
  "description": "All registered Bricks element types with metadata (name, label, category, nestable).",
  "input_schema": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "description": "Filter by element category."
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "description": "Page number (1-indexed). Defaults to 1."
      },
      "perPage": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Items per page. Defaults to 25, max 200."
      }
    },
    "additionalProperties": false,
    "default": {}
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array"
      },
      "total": {
        "type": "integer"
      },
      "page": {
        "type": "integer"
      },
      "perPage": {
        "type": "integer"
      },
      "hasMore": {
        "type": "boolean"
      }
    }
  },
  "meta": {
    "annotations": {
      "readonly": true,
      "destructive": false,
      "idempotent": null
    },
    "mcp": {
      "public": true,
      "type": "resource",
      "annotations": {
        "readonly": true,
        "destructive": false
      },
      "mimeType": "application/json",
      "uri": "bricks://reference/element-catalog"
    },
    "uri": "bricks://reference/element-catalog",
    "mimeType": "application/json",
    "show_in_rest": true,
    "public": false
  }
}