FIGMA_TOKEN=

AI_PROVIDER=
# Set deterministic to normalize hierarchy/measurements without an AI provider.
NORMALIZE_MODE=

ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
GEMINI_FALLBACK_MODELS=
NVIDIA_MODEL=

AI_MAX_TOKENS=
GEMINI_RETRIES=

# Optional MANUAL layout debugging only. Never called by the normal pipeline.
# Always sends both images; defaults to AI_PROVIDER and its configured model.
# Groq defaults to qwen/qwen3.8-27b; other providers need an explicit image-capable model.
VISUAL_PROVIDER=
VISUAL_MODEL=
VISUAL_MAX_TOKENS=6000
VISUAL_TIMEOUT_MS=600000
VISUAL_PROMPT_CHARS=14000
# Groq free-tier input window; set 0 only when your provider tier permits it.
VISUAL_DELAY_MS=65000
BROWSER_EXECUTABLE=

# Local vision: VISUAL_PROVIDER=ollama and VISUAL_MODEL=<installed vision model>.
# Set OLLAMA_VISION_MODEL to enable local fallback when the existing provider fails.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_NUM_CTX=8192


RENDER_URL=http://localhost:10004



WP_API_URL=
WP_API_USERNAME=
WP_API_PASSWORD=

WP_BASE_URL=
WP_APP_USER=
WP_APP_PASSWORD=
