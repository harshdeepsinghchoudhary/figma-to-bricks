# RTX 3050 6 GB / 16 GB RAM starting profile. Merge into .env; keep credentials private.
# Verify memory usage and visual quality on the actual device.
# AI is optional; --deterministic normalizes without a model. Vision is manual debugging only.
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192
AI_MAX_TOKENS=2048
VISUAL_PROVIDER=ollama
VISUAL_MODEL=gemma3:4b
VISUAL_MAX_TOKENS=2048
VISUAL_TIMEOUT_MS=600000
VISUAL_PROMPT_CHARS=10000
VISUAL_DELAY_MS=0
